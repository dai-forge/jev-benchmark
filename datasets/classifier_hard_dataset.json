{
  "name": "aegis-classifier-hard-set",
  "version": 1,
  "created": "2026-09-23",
  "status": "frozen",
  "purpose": "Classifier evaluation set built to exercise label boundaries the 48-question gold set cannot separate. Labels, routes and label_certainty are fixed before any model runs; contested rows score confidence, not the label.",
  "taxonomy_source": "specs/architecture.md 7.1",
  "corpus_scope": {
    "companies": [
      "Apple",
      "Microsoft",
      "Alphabet"
    ],
    "fiscal_years": [
      "FY2022",
      "FY2023",
      "FY2024",
      "FY2025"
    ],
    "filing_types": [
      "10-K",
      "10-Q"
    ]
  },
  "scoring_rules": [
    "A question is scored against the layer that reaches it: rows with caught_by=deterministic are scored against the pre-check layer and excluded from classifier scoring for every model.",
    "On contested rows either the expected_label or the alternative_label is acceptable; what is scored is whether confidence drops.",
    "On clear rows the expected_label is the only correct answer and confidence should hold.",
    "Results are reported per slice: general, near_miss, jev_weakness."
  ],
  "counts": {
    "total": 58,
    "by_certainty": {
      "clear": 41,
      "contested": 17
    },
    "by_slice": {
